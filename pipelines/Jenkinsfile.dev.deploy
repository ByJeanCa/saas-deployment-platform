pipeline {
    agent any

    stages {
        stage("Test API") {
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            steps {
                dir('myapp/api') {
                    sh'''
                    set -euo pipefail
                    pip install -r requirements.txt
                    pytest --junitxml=test-results/results.xml
                    '''
                }
            }
        }
        stage("Test Worker") {
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            steps {
                dir('myapp/worker') {
                    sh'''
                    set -euo pipefail
                    pip install -r requirements.txt
                    pytest --junitxml=test-results/results.xml
                    '''
                }
            }
        }
        stage("Test Frontend") {
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            steps {
                dir('myapp/frontend') {
                    sh'''
                    set -euo pipefail
                    pip install -r requirements.txt
                    pytest --junitxml=test-results/results.xml
                    '''
                }
            }
        }
    }
}